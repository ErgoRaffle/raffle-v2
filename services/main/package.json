{
  "name": "@ergo-raffle/main",
  "version": "0.0.0",
  "description": "",
  "repository": "",
  "license": "GPL-3.0",
  "author": "Ergo Raffle Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write . --ignore-path ./.gitignore",
    "start": "tsx watch ./src/index.ts",
    "start:prod": "node --loader extensionless ./dist/index.js",
    "test": "NODE_OPTIONS=--loader=extensionless vitest",
    "type-check": "tsc --noEmit",
    "typeorm": "NODE_OPTIONS=--experimental-specifier-resolution=node typeorm-ts-node-esm",
    "typeorm:generate:postgres": "npm run typeorm migration:generate ./src/migrations/postgres/postgres -- -p -d ./src/dataSources/postgres.ts",
    "typeorm:generate:sqlite": "npm run typeorm migration:generate ./src/migrations/sqlite/sqlite -- -p -d ./src/dataSources/sqlite.ts",
    "typeorm:migrate:postgres": "npm run typeorm migration:run -- -d ./src/dataSources/postgres.ts",
    "typeorm:migrate:sqlite": "npm run typeorm migration:run -- -d ./src/dataSources/sqlite.ts"
  },
  "dependencies": {
    "@rosen-bridge/winston-logger": "^0.2.1",
    "config": "^3.3.7",
    "express": "^4.18.1",
    "reflect-metadata": "^0.1.13",
    "sqlite3": "^5.0.8",
    "typeorm": "^0.3.6"
  },
  "devDependencies": {
    "@types/config": "^0.0.41",
    "@types/express": "^4.17.13",
    "@types/node": "^20.11.9",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "@vitest/coverage-istanbul": "^1.2.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "extensionless": "^1.9.6",
    "prettier": "^3.2.4",
    "tsx": "^4.19.3",
    "tsconfig-paths": "^4.1.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
