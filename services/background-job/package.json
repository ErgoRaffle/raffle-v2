{
  "name": "@ergo-raffle/background-job",
  "version": "0.0.0",
  "private": true,
  "description": "Ergo-Raffle background jobs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ErgoRaffle/raffle-v2"
  },
  "license": "MIT",
  "author": "Ergo Raffle Team",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "config:generate:defaults": "cross-env NODE_OPTIONS=\"--import tsx\" npx @rosen-bridge/config generate-default --schema ./config/schema.json --output ./config/default.yml --format yaml",
    "config:generate:types": "cross-env NODE_OPTIONS=\"--import tsx\" npx @rosen-bridge/config generate-ts-types --schema ./config/schema.json --output ./src/types/configs.ts --root-type BackgroundJobConfig",
    "coverage": "npm run test -- --coverage",
    "init": "tsx ./src/serviceBoxInit.ts",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "start": "tsx ./src/index.ts",
    "start:dev": "tsx watch ./src/index.ts",
    "test": "cross-env NODE_OPTIONS=\"--import tsx\" vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ergo-raffle/box-lookup": "0.1.0",
    "@ergo-raffle/boxes": "0.0.0",
    "@ergo-raffle/contracts": "0.0.0",
    "@ergo-raffle/data-source": "0.0.0",
    "@ergo-raffle/extractors": "0.0.0",
    "@ergo-raffle/fleet-box-selection": "^0.0.0",
    "@ergo-raffle/transactions": "0.0.0",
    "@ergo-raffle/utils": "^0.0.0",
    "@fleet-sdk/common": "^0.10.0",
    "@fleet-sdk/core": "^0.12.0",
    "@fleet-sdk/serializer": "^0.11.0",
    "@rosen-bridge/abstract-extractor": "^3.1.0",
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "@rosen-bridge/abstract-scanner": "^1.0.2",
    "@rosen-bridge/callback-logger": "^2.0.0",
    "@rosen-bridge/config": "^1.2.0",
    "@rosen-bridge/discord-notification": "^1.0.0",
    "@rosen-bridge/ergo-scanner": "^1.0.2",
    "@rosen-bridge/extended-typeorm": "^1.0.1",
    "@rosen-bridge/fastify-enhanced": "^2.0.1",
    "@rosen-bridge/health-check": "^8.0.0",
    "@rosen-bridge/json-bigint": "^1.1.0",
    "@rosen-bridge/scanner-interfaces": "^0.2.2",
    "@rosen-bridge/scanner-sync-check": "^8.2.0",
    "@rosen-bridge/service-manager": "^1.0.2",
    "@rosen-bridge/tx-pot": "^2.0.3",
    "@rosen-bridge/winston-logger": "^3.0.0",
    "config": "^3.3.12",
    "lodash-es": "^4.17.21",
    "pg": "^8.4.0",
    "sigmastate-js": "^0.4.6"
  },
  "devDependencies": {
    "@types/config": "^3.3.5",
    "@types/lodash-es": "^4.17.12"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
