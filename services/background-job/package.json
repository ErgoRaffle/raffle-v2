{
  "name": "@ergo-raffle/background-job",
  "version": "0.1.0",
  "description": "",
  "repository": "",
  "license": "GPL-3.0",
  "author": "Ergo Raffle Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "prettify": "prettier --write . --ignore-path ./.gitignore",
    "start": "tsx watch ./src/index.ts",
    "start:prod": "tsx ./dist/index.js",
    "test": "NODE_OPTIONS='--import tsx' vitest",
    "type-check": "tsc --noEmit",
    "typeorm": "NODE_OPTIONS='--import tsx' typeorm",
    "typeorm:generate:postgres": "npm run typeorm migration:generate ./src/migrations/postgres/postgres -- -p -d ./src/dataSource.ts",
    "typeorm:generate:sqlite": "npm run typeorm migration:generate ./src/migrations/sqlite/sqlite -- -p -d ./src/dataSource.ts",
    "typeorm:migrate:postgres": "npm run typeorm migration:run -- -d ./src/dataSource.ts",
    "typeorm:migrate:sqlite": "npm run typeorm migration:run -- -d ./src/dataSource.ts",
    "gen-config-types": "NODE_OPTIONS='--import tsx' npx @rosen-bridge/config generate-ts-types --schema ./config/schema.json --output ./src/types/configs.ts --root-type BackgroundJobConfig",
    "gen-config-defaults": "NODE_OPTIONS='--import tsx' npx @rosen-bridge/config generate-default --schema ./config/schema.json --output ./config/default.yml --format yaml"
  },
  "dependencies": {
    "@ergo-raffle/box-lookup": "^0.1.0",
    "@ergo-raffle/boxes": "^0.1.0",
    "@ergo-raffle/contracts": "^0.1.0",
    "@ergo-raffle/extractors": "^0.1.0",
    "@ergo-raffle/transactions": "^0.0.1",
    "@fleet-sdk/common": "^0.10.0",
    "@fleet-sdk/core": "^0.12.0",
    "@fleet-sdk/crypto": "^0.11.0",
    "@fleet-sdk/serializer": "^0.11.0",
    "@fleet-sdk/wallet": "^0.12.0",
    "@rosen-bridge/abstract-logger": "^2.1.0",
    "@rosen-bridge/callback-logger": "^0.1.0",
    "@rosen-bridge/config": "^0.4.0",
    "@rosen-bridge/discord-notification": "^0.2.0",
    "@rosen-bridge/extended-typeorm": "^0.2.1",
    "@rosen-bridge/fastify-enhanced": "^0.1.1",
    "@rosen-bridge/health-check": "^7.0.0",
    "@rosen-bridge/json-bigint": "^0.2.0",
    "@rosen-bridge/rate-limited-axios": "^0.2.1",
    "@rosen-bridge/scanner": "^8.0.1",
    "@rosen-bridge/scanner-interfaces": "^0.1.1",
    "@rosen-bridge/scanner-sync-check": "^7.0.0",
    "@rosen-bridge/service-manager": "^0.1.2",
    "@rosen-bridge/tx-pot": "^1.1.0",
    "@rosen-bridge/winston-logger": "^1.0.3",
    "@rosen-clients/ergo-node": "^1.2.3",
    "config": "^3.3.12",
    "lodash-es": "^4.17.21",
    "reflect-metadata": "^0.1.14",
    "sigmastate-js": "^0.4.6",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@rosen-bridge/abstract-extractor": "^2.0.2",
    "@types/config": "^3.3.5",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.9",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.4",
    "tsx": "^4.19.3",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  }
}
