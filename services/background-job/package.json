{
  "name": "@ergo-raffle/background-job",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Ergo Raffle Team",
  "description": "Ergo-Raffle background jobs",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErgoRaffle/raffle-v2"
  },
  "main": "src/index.ts",
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "test": "cross-env NODE_OPTIONS=\"--import tsx\" vitest",
    "coverage": "npm run test -- --coverage",
    "typeorm": "cross-env NODE_OPTIONS=\"--import tsx\" typeorm",
    "typeorm:generate:postgres": "npm run typeorm migration:generate src/database/migrations/postgres/migration -- -p -d src/dataSource.ts",
    "typeorm:generate:sqlite": "npm run typeorm migration:generate src/database/migrations/sqlite/migration -- -p -d ./src/dataSource.ts",
    "typeorm:migrate:postgres": "npm run typeorm migration:run -- -d ./src/dataSource.ts",
    "typeorm:migrate:sqlite": "npm run typeorm migration:run -- -d ./src/dataSource.ts",
    "config:generate:types": "cross-env NODE_OPTIONS=\"--import tsx\" npx @rosen-bridge/config generate-ts-types --schema ./config/schema.json --output ./src/types/configs.ts --root-type BackgroundJobConfig",
    "config:generate:defaults": "cross-env NODE_OPTIONS=\"--import tsx\" npx @rosen-bridge/config generate-default --schema ./config/schema.json --output ./config/default.yml --format yaml",
    "start:dev": "tsx watch ./src/index.ts",
    "start": "tsx ./src/index.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ergo-raffle/box-lookup": "0.0.0",
    "@ergo-raffle/boxes": "0.0.0",
    "@ergo-raffle/contracts": "0.0.0",
    "@ergo-raffle/extractors": "0.0.0",
    "@ergo-raffle/transactions": "0.0.0",
    "@fleet-sdk/common": "^0.10.0",
    "@fleet-sdk/compiler": "^0.12.0",
    "@fleet-sdk/core": "^0.12.0",
    "@fleet-sdk/crypto": "^0.11.0",
    "@fleet-sdk/serializer": "^0.11.0",
    "@fleet-sdk/wallet": "^0.12.0",
    "@rosen-bridge/abstract-extractor": "^2.0.2",
    "@rosen-bridge/abstract-logger": "^2.1.0",
    "@rosen-bridge/callback-logger": "^1.0.1",
    "@rosen-bridge/config": "^0.4.0",
    "@rosen-bridge/discord-notification": "^0.2.0",
    "@rosen-bridge/extended-typeorm": "^1.0.1",
    "@rosen-bridge/fastify-enhanced": "^1.0.0",
    "@rosen-bridge/health-check": "^7.0.0",
    "@rosen-bridge/json-bigint": "^0.2.0",
    "@rosen-bridge/rate-limited-axios": "^0.2.1",
    "@rosen-bridge/scanner": "^8.0.1",
    "@rosen-bridge/scanner-interfaces": "^0.1.1",
    "@rosen-bridge/scanner-sync-check": "^7.0.0",
    "@rosen-bridge/service-manager": "^0.1.2",
    "@rosen-bridge/tx-pot": "^2.0.2",
    "@rosen-bridge/winston-logger": "^1.0.3",
    "@rosen-clients/ergo-node": "^1.2.3",
    "config": "^3.3.12",
    "lodash-es": "^4.17.21",
    "sigmastate-js": "^0.4.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/config": "^3.3.5",
    "@types/lodash-es": "^4.17.12"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
