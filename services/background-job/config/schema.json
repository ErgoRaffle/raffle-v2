{
  "logs": {
    "type": "array",
    "default": [
      {
        "type": "console"
      },
      {
        "type": "file",
        "path": "./logs/",
        "maxSize": "20m",
        "maxFiles": "14d"
      }
    ],
    "items": {
      "type": "object",
      "children": {
        "type": {
          "type": "string",
          "description": "options: file, console, loki",
          "default": "file",
          "validations": [
            {
              "required": true,
              "error": "log type must be specified"
            },
            { "choices": ["file", "console", "loki"] }
          ]
        },
        "maxSize": {
          "type": "string",
          "validations": [
            {
              "required": true,
              "error": "maxSize for file log type must be specified",
              "when": { "path": "logs.type", "value": "file" }
            }
          ]
        },
        "maxFiles": {
          "type": "string",
          "validations": [
            {
              "required": true,
              "error": "maxFiles for file log type must be specified",
              "when": { "path": "logs.type", "value": "file" }
            }
          ]
        },
        "path": {
          "type": "string",
          "validations": [
            {
              "required": true,
              "error": "path for file log type must be specified",
              "when": { "path": "logs.type", "value": "file" }
            }
          ]
        },
        "level": {
          "type": "string",
          "default": "info",
          "validations": [
            {
              "required": true,
              "error": "log level must be specified"
            }
          ]
        },
        "serviceName": {
          "type": "string",
          "validations": [
            {
              "required": true,
              "error": "Service-Name for the \"loki\" log type must be specified",
              "when": { "path": "logs.type", "value": "loki" }
            }
          ]
        },
        "host": {
          "type": "string",
          "validations": [
            {
              "required": true,
              "error": "host for the \"loki\" log type must be specified",
              "when": { "path": "logs.type", "value": "loki" }
            }
          ]
        },
        "basicAuth": {
          "type": "string"
        }
      }
    }
  },
  "database": {
    "type": "object",
    "children": {
      "type": {
        "type": "string",
        "default": "postgres",
        "validations": [
          {
            "required": true,
            "error": "database type must be specified"
          },
          { "choices": ["sqlite", "postgres"] }
        ]
      },
      "host": {
        "type": "string",
        "default": "localhost",
        "validations": [
          {
            "required": true,
            "when": { "path": "database.type", "value": "postgres" },
            "error": "host for the \"postgres\" database address must be specified"
          }
        ]
      },
      "port": {
        "type": "number",
        "default": 5432,
        "validations": [
          {
            "required": true,
            "when": { "path": "database.type", "value": "postgres" },
            "error": "port for the \"postgres\" database must be specified"
          }
        ]
      },
      "username": {
        "type": "string",
        "default": "postgres"
      },
      "password": {
        "type": "string",
        "default": ""
      },
      "name": {
        "type": "string",
        "default": "raffle_v2",
        "validations": [
          {
            "required": true,
            "when": { "path": "database.type", "value": "postgres" },
            "error": "postgres database name is required"
          }
        ]
      },
      "path": {
        "type": "string",
        "validations": [
          {
            "required": true,
            "when": { "path": "database.type", "value": "sqlite" },
            "error": "sqlite database path is required"
          }
        ]
      }
    }
  },
  "scanner": {
    "type": "object",
    "children": {
      "node": {
        "type": "object",
        "children": {
          "url": {
            "type": "string",
            "default": "http://127.0.0.1:9052/",
            "description": "scanner node url",
            "validations": [
              {
                "required": true,
                "error": "scanner node url must be specified"
              }
            ]
          },
          "timeout": {
            "type": "number",
            "default": 10,
            "description": "ergo node timeout in seconds",
            "validations": [
              {
                "required": true,
                "error": "ergo node timeout must be specified"
              }
            ]
          },
          "initialHeight": {
            "type": "number",
            "description": "ergo node scanner initial-height",
            "validations": [
              {
                "required": true,
                "error": "scanner initial-height must be specified"
              }
            ]
          }
        }
      },
      "scannerInterval": {
        "type": "number",
        "default": 30,
        "description": "scanner update interval in seconds",
        "validations": [
          {
            "required": true,
            "error": "scanner update interval must be specified"
          }
        ]
      }
    }
  },
  "txpot": {
    "type": "object",
    "children": {
      "updateInterval": {
        "type": "number",
        "description": "tx-pot update interval in seconds",
        "default": 60,
        "validations": [
          {
            "required": true,
            "error": "tx-pot update interval must be specified"
          }
        ]
      },
      "txRequiredConfirmations": {
        "type": "number",
        "default": 5,
        "description": "tx-pot required confirmations",
        "validations": [
          {
            "required": true,
            "error": "tx-pot required confirmations must be specified"
          }
        ]
      }
    }
  },
  "ergo": {
    "type": "object",
    "children": {
      "fee": {
        "type": "bigint",
        "default": 1500000,
        "description": "ergo node fee in nano erg",
        "validations": [
          {
            "required": true,
            "error": "ergo node fee must be specified"
          }
        ]
      }
    }
  },
  "healthCheck": {
    "type": "object",
    "children": {
      "updateInterval": {
        "type": "number",
        "default": 60,
        "description": "health check update interval in seconds",
        "validations": [
          {
            "required": true,
            "error": "health check update interval must be specified"
          }
        ]
      },
      "warnBlockGap": {
        "type": "number",
        "default": 2,
        "description": "warning threshold for block gap",
        "validations": [
          {
            "required": true,
            "error": "warn block gap must be specified"
          }
        ]
      },
      "criticalBlockGap": {
        "type": "number",
        "default": 10,
        "description": "critical threshold for block gap",
        "validations": [
          {
            "required": true,
            "error": "critical block gap must be specified"
          }
        ]
      }
    }
  },
  "notification": {
    "type": "object",
    "children": {
      "discordWebHookUrl": {
        "type": "string",
        "description": "discord webhook URL for notifications"
      },
      "historyCleanupTimeout": {
        "type": "number",
        "description": "history cleanup timeout in seconds"
      },
      "hasBeenUnstableForAWhileWindowDuration": {
        "type": "number",
        "description": "window duration for unstable state check in seconds"
      },
      "hasBeenUnknownForAWhileWindowDuration": {
        "type": "number",
        "description": "window duration for unknown state check in seconds"
      }
    }
  },
  "boxLookup": {
    "type": "object",
    "children": {
      "updateInterval": {
        "type": "number",
        "default": 60,
        "description": "box lookup update interval in seconds",
        "validations": [
          {
            "required": true,
            "error": "box lookup update interval must be specified"
          }
        ]
      }
    }
  },
  "tokenDetails": {
    "type": "object",
    "children": {
      "updateInterval": {
        "type": "number",
        "default": 60,
        "description": "token details sync interval for inactive raffles, in seconds",
        "validations": [
          {
            "required": true,
            "error": "token details update interval must be specified"
          }
        ]
      }
    }
  },
  "addresses": {
    "type": "object",
    "children": {
      "serviceFeeAddress": {
        "type": "string",
        "description": "service fee address",
        "validations": [
          {
            "required": true,
            "error": "service fee address must be specified"
          }
        ]
      }
    }
  },
  "ipfs": {
    "type": "object",
    "children": {
      "accessKey": {
        "type": "string",
        "description": "Filebase S3 API access key for IPFS uploads (see https://filebase.github.io/filebase-sdk/)",
        "validations": [
          {
            "required": true,
            "error": "Filebase access key must be specified"
          }
        ]
      },
      "secretKey": {
        "type": "string",
        "description": "Filebase S3 API secret key for IPFS uploads",
        "validations": [
          {
            "required": true,
            "error": "Filebase secret key must be specified"
          }
        ]
      },
      "bucket": {
        "type": "string",
        "description": "Filebase bucket name (IPFS-backed storage)",
        "validations": [
          {
            "required": true,
            "error": "Filebase bucket must be specified"
          }
        ]
      }
    }
  },
  "social": {
    "type": "object",
    "children": {
      "provider": {
        "type": "string",
        "default": "thirdparty",
        "description": "active mentions data source",
        "validations": [{ "choices": ["official", "thirdparty"] }]
      },
      "pollInterval": {
        "type": "number",
        "default": 1800,
        "description": "seconds between mention polls (default 30 min)"
      },
      "handle": {
        "type": "string",
        "default": "ergoraffle",
        "description": "@ergoraffle handle without '@'"
      },
      "userId": {
        "type": "string",
        "default": "",
        "description": "numeric X user id of @ergoraffle (official API); set via env when available"
      },
      "allowHosts": {
        "type": "array",
        "default": [
          "ergoraffle.com",
          "testnet-beta.ergoraffle.com",
          "*.ergoraffle.com",
          "raffle.rosen.tech"
        ],
        "description": "allow-listed raffle-URL hosts; exact or '*.domain' wildcard (apex + subdomains)",
        "items": { "type": "string" }
      },
      "searchDomains": {
        "type": "array",
        "default": ["ergoraffle.com"],
        "description": "raffle domains searched in tweet URLs for discovery (the 'url:' prong); subdomains match too",
        "items": { "type": "string" }
      },
      "official": {
        "type": "object",
        "children": {
          "bearerToken": {
            "type": "string",
            "default": "",
            "description": "X API v2 app bearer token; set via env"
          },
          "maxPages": {
            "type": "number",
            "default": 5,
            "description": "max pages followed per tick (cost cap)"
          }
        }
      },
      "thirdparty": {
        "type": "object",
        "children": {
          "apiKey": {
            "type": "string",
            "default": "",
            "description": "twitterapi.io API key; set via env"
          },
          "maxPages": {
            "type": "number",
            "default": 5,
            "description": "max pages followed per tick (cost cap)"
          }
        }
      },
      "filters": {
        "type": "object",
        "children": {
          "keywords": {
            "type": "array",
            "default": [
              "airdrop",
              "free crypto",
              "giveaway",
              "double your",
              "claim now",
              "dm me",
              "seed phrase",
              "wallet validation",
              "connect your wallet",
              "t.me/",
              "metamask",
              "elon"
            ],
            "description": "lower-cased substrings; a tweet containing any is dropped",
            "items": { "type": "string" }
          },
          "minAccountAgeDays": {
            "type": "number",
            "default": 30,
            "description": "minimum author account age in days"
          },
          "minFollowers": {
            "type": "number",
            "default": 5,
            "description": "minimum author follower count"
          },
          "maxPerAuthorPerRaffle": {
            "type": "number",
            "default": 3,
            "description": "max posts from one author on one raffle"
          }
        }
      }
    }
  }
}
