{
  "logs": {
    "type": "array",
    "default": [
      {
        "type": "console"
      },
      {
        "type": "file",
        "path": "./logs/",
        "maxSize": "20m",
        "maxFiles": "14d"
      }
    ],
    "items": {
      "type": "object",
      "children": {
        "type": {
          "type": "string",
          "description": "options: file, console, loki",
          "default": "file",
          "validations": [
            {
              "required": true,
              "error": "log type must be specified"
            },
            { "choices": ["file", "console", "loki"] }
          ]
        },
        "maxSize": {
          "type": "string",
          "validations": [
            {
              "required": true,
              "error": "maxSize for file log type must be specified",
              "when": { "path": "logs.type", "value": "file" }
            }
          ]
        },
        "maxFiles": {
          "type": "string",
          "validations": [
            {
              "required": true,
              "error": "maxFiles for file log type must be specified",
              "when": { "path": "logs.type", "value": "file" }
            }
          ]
        },
        "path": {
          "type": "string",
          "validations": [
            {
              "required": true,
              "error": "path for file log type must be specified",
              "when": { "path": "logs.type", "value": "file" }
            }
          ]
        },
        "level": {
          "type": "string",
          "default": "info",
          "validations": [
            {
              "required": true,
              "error": "log level must be specified"
            }
          ]
        },
        "serviceName": {
          "type": "string",
          "validations": [
            {
              "required": true,
              "error": "Service-Name for the \"loki\" log type must be specified",
              "when": { "path": "logs.type", "value": "loki" }
            }
          ]
        },
        "host": {
          "type": "string",
          "validations": [
            {
              "required": true,
              "error": "host for the \"loki\" log type must be specified",
              "when": { "path": "logs.type", "value": "loki" }
            }
          ]
        },
        "basicAuth": {
          "type": "string"
        }
      }
    }
  },
  "database": {
    "type": "object",
    "children": {
      "type": {
        "type": "string",
        "default": "postgres",
        "validations": [
          {
            "required": true,
            "error": "database type must be specified"
          },
          { "choices": ["sqlite", "postgres"] }
        ]
      },
      "host": {
        "type": "string",
        "default": "localhost",
        "validations": [
          {
            "required": true,
            "when": { "path": "database.type", "value": "postgres" },
            "error": "host for the \"postgres\" database address must be specified"
          }
        ]
      },
      "port": {
        "type": "number",
        "default": 5432,
        "validations": [
          {
            "required": true,
            "when": { "path": "database.type", "value": "postgres" },
            "error": "port for the \"postgres\" database must be specified"
          }
        ]
      },
      "username": {
        "type": "string",
        "default": "postgres"
      },
      "password": {
        "type": "string",
        "default": ""
      },
      "name": {
        "type": "string",
        "default": "raffle_v2",
        "validations": [
          {
            "required": true,
            "when": { "path": "database.type", "value": "postgres" },
            "error": "postgres database name is required"
          }
        ]
      },
      "path": {
        "type": "string",
        "validations": [
          {
            "required": true,
            "when": { "path": "database.type", "value": "sqlite" },
            "error": "sqlite database path is required"
          }
        ]
      }
    }
  },
  "api": {
    "type": "object",
    "children": {
      "host": {
        "type": "string",
        "default": "localhost",
        "description": "API server host",
        "validations": [
          {
            "required": true,
            "error": "API host must be specified"
          }
        ]
      },
      "port": {
        "type": "number",
        "default": 3000,
        "description": "API server port",
        "validations": [
          {
            "required": true,
            "error": "API port must be specified"
          }
        ]
      }
    }
  },
  "captcha": {
    "type": "object",
    "description": "Captcha verification for public API routes (e.g. donation)",
    "children": {
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable or disable captcha validation for public API routes",
        "validations": [
          {
            "required": true,
            "error": "captcha enabled flag must be specified"
          }
        ]
      },
      "secret": {
        "type": "string",
        "default": "6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe",
        "description": "Captcha provider secret key (e.g. reCAPTCHA secret); set in deployment or local.yml",
        "validations": [
          {
            "required": true,
            "when": { "path": "captcha.enabled", "value": true },
            "error": "captcha secret must be specified"
          }
        ]
      },
      "url": {
        "type": "string",
        "default": "https://www.google.com/recaptcha/api/siteverify",
        "description": "Captcha provider token verification endpoint URL",
        "validations": [
          {
            "required": true,
            "when": { "path": "captcha.enabled", "value": true },
            "error": "captcha verification URL must be specified"
          }
        ]
      }
    }
  },
  "ergo": {
    "type": "object",
    "children": {
      "mnemonic": {
        "type": "string",
        "description": "Ergo wallet mnemonic",
        "validations": [
          {
            "required": true,
            "error": "Ergo wallet mnemonic must be specified"
          }
        ]
      },
      "fee": {
        "type": "bigint",
        "default": 1500000,
        "description": "ergo transaction fee in nano erg",
        "validations": [
          {
            "required": true,
            "error": "ergo transaction fee must be specified"
          }
        ]
      },
      "nodeUrl": {
        "type": "string",
        "description": "Ergo node URL",
        "validations": [
          {
            "required": true,
            "error": "Ergo node URL must be specified"
          }
        ]
      }
    }
  },
  "bitcoin": {
    "type": "object",
    "children": {
      "mnemonic": {
        "type": "string",
        "description": "Bitcoin wallet mnemonic",
        "validations": [
          {
            "required": true,
            "error": "Bitcoin mnemonic must be specified"
          }
        ]
      },
      "network": {
        "type": "string",
        "description": "Bitcoin network type",
        "default": "mainnet",
        "validations": [
          {
            "required": true,
            "error": "Bitcoin network type must be specified"
          },
          { "choices": ["mainnet", "testnet"] }
        ]
      },
      "rpc": {
        "type": "object",
        "children": {
          "url": {
            "type": "string",
            "description": "Bitcoin RPC base URL",
            "validations": [
              {
                "required": true,
                "error": "bitcoin RPC url must be specified"
              }
            ]
          },
          "timeout": {
            "type": "number",
            "default": 30,
            "description": "RPC timeout in seconds",
            "validations": [
              {
                "required": true,
                "error": "scanner RPC timeout must be specified"
              }
            ]
          },
          "username": {
            "type": "string",
            "description": "Bitcoin Core RPC username (optional)"
          },
          "password": {
            "type": "string",
            "description": "Bitcoin Core RPC password (optional)"
          }
        }
      },
      "scannerInterval": {
        "type": "number",
        "default": 30,
        "description": "scanner update interval in seconds",
        "validations": [
          {
            "required": true,
            "error": "scanner update interval must be specified"
          }
        ]
      },
      "initialHeight": {
        "type": "number",
        "description": "Bitcoin scanner initial block height",
        "validations": [
          {
            "required": true,
            "error": "scanner initial block height must be specified"
          }
        ]
      },
      "runes": {
        "type": "object",
        "children": {
          "unisat": {
            "type": "object",
            "description": "Unisat indexer API for runes data",
            "children": {
              "url": {
                "type": "string",
                "description": "Unisat API base URL",
                "default": "https://open-api.unisat.io",
                "validations": [
                  {
                    "required": true,
                    "error": "Unisat API base URL must be specified"
                  }
                ]
              },
              "apiKey": {
                "type": "string",
                "description": "Unisat API key"
              }
            }
          }
        }
      }
    }
  },
  "donation": {
    "type": "object",
    "children": {
      "interval": {
        "type": "number",
        "default": 60,
        "description": "donation service interval in seconds",
        "validations": [
          {
            "required": true,
            "error": "donation service interval must be specified"
          }
        ]
      },
      "requiredConfirmations": {
        "type": "number",
        "default": 2,
        "description": "required Bitcoin block confirmations before creating donation tx",
        "validations": [
          {
            "required": true,
            "error": "required confirmations must be specified"
          }
        ]
      },
      "requestTimeout": {
        "type": "number",
        "default": 3600,
        "description": "donation request timeout in seconds; pending requests older than this are marked timed out",
        "validations": [
          {
            "required": true,
            "error": "donation request timeout must be specified"
          }
        ]
      },
      "fee": {
        "type": "bigint",
        "default": 10000,
        "description": "additional donation fee amount in satoshi",
        "validations": [
          {
            "required": true,
            "error": "donation fee must be specified"
          }
        ]
      }
    }
  },
  "tokenMap": {
    "type": "object",
    "children": {
      "type": {
        "type": "string",
        "description": "token map type: file, url",
        "default": "file",
        "validations": [
          {
            "required": true,
            "error": "token map type must be specified"
          },
          { "choices": ["file", "url"] }
        ]
      },
      "path": {
        "type": "string",
        "description": "token map path",
        "default": "config/tokenMap.json",
        "validations": [
          {
            "required": true,
            "when": { "path": "tokenMap.type", "value": "file" },
            "error": "token map path must be specified when type is file"
          }
        ]
      },
      "url": {
        "type": "string",
        "description": "token map url",
        "validations": [
          {
            "required": true,
            "when": { "path": "tokenMap.type", "value": "url" },
            "error": "token map url must be specified when type is url"
          }
        ]
      },
      "refreshIntrval": {
        "type": "number",
        "default": 3600,
        "description": "seconds between token map refreshes when type is url",
        "validations": [
          {
            "required": true,
            "when": { "path": "tokenMap.type", "value": "url" },
            "error": "token map refresh interval must be specified when type is url"
          }
        ]
      }
    }
  }
}
