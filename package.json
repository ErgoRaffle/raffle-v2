{
  "name": "raffle-v2",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "prepare": "husky install",
    "release": "npm run release --workspaces",
    "type-check": "npm run type-check --workspaces",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "lint-staged": "^13.0.3",
    "patch-package": "^8.0.0"
  }
}
