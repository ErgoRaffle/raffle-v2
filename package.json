{
  "name": "raffle-v2",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*"
    ]
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "prepare": "husky install",
    "release": "npm run release --workspaces",
    "type-check": "npm run type-check --workspaces",
    "test": "vitest",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "husky": "^8.0.0",
    "lint-staged": "^13.0.3",
    "patch-package": "^8.0.0",
    "patch-packages": "^1.0.0",
    "vitest": "^1.5.0"
  },
  "dependencies": {
    "@fleet-sdk/compiler": "^0.3.4",
    "@fleet-sdk/core": "^0.3.4",
    "@fleet-sdk/mock-chain": "^0.3.4",
    "sigmastate-js": "^0.4.0",
    "winston": "^3.13.0"
  }
}
