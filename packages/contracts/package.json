{
  "name": "@ergo-raffle/contracts",
  "version": "0.0.0",
  "description": "Raffle v2 related contracts",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErgoRaffle/raffle-v2"
  },
  "license": "MIT",
  "author": "Ergo Raffle Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "mkdir -p dist/ && tsx --trace-warnings ./cli/index.ts build configs.json",
    "build-testnet": "npm run build -- --testnet",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "compile-contracts": "tsx ./cli/index.ts compile-contracts",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "make-build-template": "tsx ./cli/index.ts make-input-template --for-build",
    "make-input-template": "tsx ./cli/index.ts make-input-template",
    "prettify": "prettier --write . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "release": "npm run test -- --run && npm run build && npm publish --access public",
    "test": "cross-env NODE_OPTIONS=\"--import tsx\" vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fleet-sdk/common": "^0.10.0",
    "@fleet-sdk/compiler": "^0.12.0",
    "@fleet-sdk/core": "^0.12.0",
    "@fleet-sdk/crypto": "^0.11.0",
    "@fleet-sdk/serializer": "^0.11.0",
    "@fleet-sdk/wallet": "^0.12.0",
    "commander": "^12.1.0",
    "sigmastate-js": "^0.4.6",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@ergo-raffle/transactions": "0.0.0",
    "@fleet-sdk/mock-chain": "^0.12.0"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
