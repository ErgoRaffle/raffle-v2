{
  "name": "@ergo-raffle/tokens",
  "version": "0.0.0",
  "description": "Manages tokens data used as raffle collecting token",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ergoraffle/raffle-v2"
  },
  "license": "MIT",
  "author": "ErgoRaffle Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run clean && npm run build && npm publish --access public",
    "test": "cross-env NODE_OPTIONS=\"--import tsx\" vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ergo-raffle/utils": "0.0.0",
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "@rosen-bridge/extended-typeorm": "^1.0.1"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
