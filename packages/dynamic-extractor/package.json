{
  "name": "@ergo-raffle/dynamic-extractor",
  "version": "0.0.0",
  "description": "Dynamic bitcoin payment extractor",
  "repository": {
    "type": "git",
    "url": "https://github.com/ErgoRaffle/raffle-v2"
  },
  "license": "MIT",
  "author": "ErgoRaffle Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run test -- --run && npm run clean && npm run build && npm publish --access public",
    "test": "cross-env NODE_OPTIONS=\"--import tsx\" vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@rosen-bridge/abstract-extractor": "^3.0.1",
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "@rosen-bridge/address-codec": "^1.2.0",
    "@rosen-bridge/json-bigint": "^1.1.0",
    "@rosen-clients/rate-limited-axios": "^1.1.1",
    "@rosen-bridge/bitcoin-scanner": "^1.0.1",
    "@rosen-bridge/extended-typeorm": "^1.0.1",
    "@rosen-bridge/scanner-interfaces": "^0.2.2",
    "bitcoinjs-lib": "^6.1.7",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
