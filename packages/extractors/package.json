{
  "name": "@ergo-raffle/extractors",
  "version": "0.0.0",
  "private": true,
  "description": "Raffle v2 related extractors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ergoraffle/raffle-v2"
  },
  "license": "MIT",
  "author": "Ergo Raffle Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "clean": "rimraf dist && rimraf tsconfig.build.tsbuildinfo",
    "coverage": "npm run test -- --coverage",
    "lint": "eslint --fix . && npm run prettify",
    "lint:check": "eslint . && npm run prettify:check",
    "prettify": "prettier --write . --ignore-path ../../.gitignore",
    "prettify:check": "prettier --check . --ignore-path ../../.gitignore",
    "release": "npm run test -- --run && npm run clean && npm run build && npm publish --access public",
    "test": "cross-env NODE_OPTIONS=\"--import tsx\" vitest",
    "type-check": "tsc --noEmit",
    "typeorm": "cross-env NODE_OPTIONS='--import tsx' typeorm",
    "typeorm:generate:postgres": "npm run typeorm migration:generate ./lib/migrations/postgres/migration -- -p -d ./lib/dataSource.ts",
    "typeorm:generate:sqlite": "npm run typeorm migration:generate ./lib/migrations/sqlite/migration -- -p -d ./lib/dataSource.ts"
  },
  "dependencies": {
    "@fleet-sdk/core": "^0.12.0",
    "@fleet-sdk/serializer": "^0.11.0",
    "@rosen-bridge/abstract-extractor": "^3.1.0",
    "@rosen-bridge/abstract-logger": "^4.0.0",
    "@rosen-bridge/abstract-scanner": "^1.0.2",
    "@rosen-bridge/extended-typeorm": "^1.0.1",
    "@rosen-bridge/scanner-interfaces": "^0.2.2",
    "lodash-es": "^4.17.21"
  },
  "devDependencies": {
    "@fleet-sdk/compiler": "^0.12.0",
    "@fleet-sdk/crypto": "^0.11.0",
    "@fleet-sdk/mock-chain": "^0.12.0",
    "@types/lodash-es": "^4.17.12"
  },
  "engines": {
    "node": ">=22.18.0",
    "npm": "11.6.2"
  }
}
