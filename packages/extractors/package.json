{
  "name": "@ergo-raffle/extractors",
  "version": "0.0.0",
  "description": "Raffle v2 related extractors",
  "repository": "",
  "license": "GPL-3.0",
  "author": "Ergo Raffle Team",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "release": "npm run build && npm publish --access public",
    "type-check": "tsc --noEmit",
    "start": "ts-node src/index.ts",
    "typeorm:generate:sqlite": "npm run typeorm migration:generate ./lib/migrations/sqlite/sqlite -- -p -d ./lib/dataSource.ts",
    "typeorm:generate:postgres": "npm run typeorm migration:generate ./lib/migrations/postgres/postgres -- -p -d ./lib/dataSource.ts",
    "typeorm:migrate": "npm run typeorm migration:run -- -d lib/dataSource.ts",
    "typeorm": "NODE_OPTIONS=--experimental-specifier-resolution=node typeorm-ts-node-esm"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^16.11.10",
    "ts-node": "10.9.1",
    "typescript": "4.5.2"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "@rosen-bridge/abstract-extractor": "^0.3.1",
    "@rosen-bridge/abstract-logger": "^2.0.1",
    "@rosen-bridge/scanner": "^5.0.0",
    "@rosen-bridge/winston-logger": "^1.0.2",
    "@types/json-bigint": "^1.0.4",
    "commander": "^13.0.0",
    "ergo-lib-wasm-nodejs": "^0.28.0",
    "json-bigint": "^1.0.0",
    "lodash-es": "^4.17.21",
    "pg": "^8.4.0",
    "reflect-metadata": "^0.1.13",
    "sqlite3": "^5.1.7",
    "typeorm": "0.3.20"
  }
}
